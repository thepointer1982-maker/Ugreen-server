[Unit]
Description=AEGIS local NAS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aegis
Group=aegis
EnvironmentFile=-/etc/aegis/bridge.env
WorkingDirectory=/opt/aegis/Ugreen-server
ExecStart=/usr/bin/env bash /opt/aegis/Ugreen-server/scripts/aegis_local_bridge.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aegis/Ugreen-server /var/log/aegis
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
