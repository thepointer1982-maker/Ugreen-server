[Unit]
Description=AEGIS local NAS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@AEGIS_USER@
Group=@AEGIS_GROUP@
EnvironmentFile=-/etc/aegis/bridge.env
WorkingDirectory=@AEGIS_REPO_ROOT@
ExecStart=/usr/bin/env bash @AEGIS_REPO_ROOT@/scripts/aegis_local_bridge.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=@AEGIS_REPO_ROOT@
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
