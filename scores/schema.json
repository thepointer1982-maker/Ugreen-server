{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS score snapshot",
  "type": "object",
  "required": ["generated_at", "network_score", "devices"],
  "properties": {
    "generated_at": {"type": "string"},
    "network_score": {"type": "number", "minimum": 0, "maximum": 100},
    "deepdiag_score": {"type": "number", "minimum": 0, "maximum": 100},
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "ip": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "reachable": {"type": "boolean"},
          "anomaly_score": {"type": "number"},
          "core_identity_confidence": {"type": "number", "minimum": 0, "maximum": 100},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "findings": {"type": "array"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
